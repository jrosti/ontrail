{
  "name": "ontrail-api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/server.ts",
    "start": "bun src/server.ts",
    "build": "bun build src/server.ts --target bun --outdir dist",
    "test": "bun test --coverage",
    "lint": "biome check src package.json biome.json",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "db:migrate": "bun src/db/migrate.ts"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.4",
    "jose": "^6.2.13",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.3",
    "bun-types": "^1.4.4",
    "testcontainers": "^12.2.1",
    "typescript": "^7.0.2"
  }
}

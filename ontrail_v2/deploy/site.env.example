# Yksi tiedosto kuvaa yhden julkaisukohteen (esim. ontrail-test.axorion.fi tai ontrail.net). Kopioi: cp site.env.example site.env
# Skriptit lukevat sen (SITE_ENV=polku ylikirjoittaa). Tiedostossa EI ole salaisuuksia; ne generoidaan palvelimella tai annetaan ympäristömuuttujina.

# ── Pakolliset ───────────────────────────────────────────────────────────────
SITE_HOST=ontrail-test.axorion.fi        # selaimessa näkyvä osoite (Hanko WebAuthn-RP-ID ja alkuperä)
SSH_HOST=root@ssh.example.fi             # palvelin, jolle julkaistaan

# ── Nimet ja polut (oletukset sulkeissa) ─────────────────────────────────────
APP=ontrail                              # palvelun nimi: käyttäjä, hakemistot, systemd-yksiköt ja tietokannat johdetaan tästä
# APP_DIR=/opt/$APP   ETC_DIR=/etc/$APP   DB_NAME=$APP   HANKO_DB_NAME=${APP}_hanko   DB_USER=$APP
# API_PORT=3002   HANKO_PORT=8000   HANKO_ADMIN_PORT=8001     (jaetulla koneella valitse vapaat portit)
# ORIGIN_HOST=$SITE_HOST   alkupään nginx-nimi; aseta eri arvoksi vain, jos Cloudflare-reuna on edessä (esim. ontrail-origin.example.fi)
# SSL_CERT=/etc/ssl/$APP/origin.pem   SSL_KEY=/etc/ssl/$APP/origin.key   (TLS-sertifikaatti nginxille; asenna itse)
# BUN_VERSION=1.3.14

# ── Sähköposti (Hanko-kirjautumisviestit) ───────────────────────────────────
SMTP_HOST=smtp.example.fi
SMTP_PORT=587
SMTP_USER=lahettaja@example.fi          # tyhjä = ei kirjautumista (esim. paikallinen välitys)
SMTP_FROM_ADDRESS=lahettaja@example.fi
SMTP_FROM_NAME=OnTrail
# Salasana EI tähän: palvelimella tiedostossa $ETC_DIR/smtp-password (chmod 600, vain root), tai SMTP_PASSWORD ympäristössä setup-ajon ajaksi.

# ── Hanko ────────────────────────────────────────────────────────────────────
# HANKO_SRC=$HOME/work/private/hanko/backend   Hankon lähdekoodi, johon infra/hanko/patches sovelletaan (kopioon, ei lähdepuuhun)

# ── Autostop (joutilaana sammutus): 0 = pois, 1 = oma ajastin, peers = rekisteröi tämä toisen sovelluksen ajastimelle ──
AUTOSTOP=0
# IDLE_GRACE_MS=1200000                  joutilaisuusaika ennen sammutusta (20 min)
# PEERS_FILE=/etc/punakyna/idle-peers    AUTOSTOP=peers: tiedosto, johon /api/idle-osoite lisätään
# Sammutuskytkin on palvelimella: echo enabled > /etc/$APP/autostop (oma ajastin) – ota käyttöön vasta kun herätys on kokeiltu.

# ── Autostart (Cloudflare-reuna: staattinen käyttöliittymä + herätys). Tyhjä EDGE_WORKER = ei reunaa ──────────────────────
# EDGE_WORKER=ontrail-edge
# TURNSTILE_SITE_KEY=...                 julkinen sivustoavain (Cloudflare → Turnstile; hostname = SITE_HOST:n ylätaso)
# Salaisuudet Workerille: wrangler secret put UPCLOUD_API_TOKEN / UPCLOUD_SERVER_UUID / TURNSTILE_SECRET_KEY (nimellä $EDGE_WORKER)
# UPCLOUD_API_TOKEN ja UPCLOUD_SERVER_UUID ympäristössä saavat myös deploy.sh:n herättämään nukkuvan palvelimen ennen julkaisua.
